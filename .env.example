# MongoDB Atlas Credentials Template
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats?retryWrites=true&w=majority

# Service-specific MongoDB Atlas URIs
MONGODB_URI_AUTH=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats_auth?retryWrites=true&w=majority
MONGODB_URI_RESTAURANT=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats_restaurant?retryWrites=true&w=majority
MONGODB_URI_ORDER=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats_order?retryWrites=true&w=majority
MONGODB_URI_DELIVERY=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats_delivery?retryWrites=true&w=majority
MONGODB_URI_NOTIFICATION=mongodb+srv://${MONGODB_USER}:${MONGODB_PASSWORD}@<cluster-url>/smarteats_notification?retryWrites=true&w=majority
